# ============================================================
# OmniAlpha — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# SQLite (default, zero-install dev):
DATABASE_URL=sqlite:///./omni_alpha.db
# PostgreSQL (Docker):
# DATABASE_URL=postgresql+asyncpg://omniuser:omnipass@localhost:5432/omni_alpha

POSTGRES_USER=omniuser
POSTGRES_PASSWORD=omnipass
POSTGRES_DB=omni_alpha

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App mode ─────────────────────────────────────────────────
# MOCK_MODE=true  → synthetic data, zero external API calls (recommended for first run)
MOCK_MODE=true

# !! DANGER — set false to use paper-trading only (still no real money)
LIVE_TRADING_ENABLED=false

# !! DANGER — set false only after reading RISK_CONTROLS.md carefully
MANUAL_APPROVAL_REQUIRED=true

# ── Portfolio defaults ────────────────────────────────────────
INITIAL_BALANCE=100000.0
# Account type: conservative | balanced | aggressive
ACCOUNT_TYPE=balanced

# ── Risk limits (fractions of portfolio) ─────────────────────
MAX_POSITION_SIZE_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.15
MAX_LEVERAGE=1.0
MIN_CASH_PCT=0.10

# ── Execution simulation ─────────────────────────────────────
COMMISSION_RATE=0.001
SLIPPAGE_RATE=0.0005

# ── Scheduling ───────────────────────────────────────────────
ANALYSIS_INTERVAL_SECONDS=300

# ── Optional API keys (system falls back to mock if blank) ───
# TODO: obtain your own keys — see docs/DATA_SOURCES.md
ALPHA_VANTAGE_KEY=
NEWS_API_KEY=
FINNHUB_KEY=
POLYGON_KEY=
FRED_API_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ── Kill switch ──────────────────────────────────────────────
KILL_SWITCH_ENABLED=false

# ── Watchlists ───────────────────────────────────────────────
STOCK_WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META
ETF_WATCHLIST=SPY,QQQ,GLD,TLT,IWM
CRYPTO_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT
FOREX_WATCHLIST=EURUSD=X,GBPUSD=X
