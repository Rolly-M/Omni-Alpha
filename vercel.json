{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "MOCK_MODE": "true",
    "LIVE_TRADING_ENABLED": "false",
    "MANUAL_APPROVAL_REQUIRED": "true"
  }
}
